      ],
      "exact_correction": "After explicitly reopening T005 or recording an eligible in-scope correction owner, make structural/route/template failures reached through validate_workflow_definition emit contextual WorkflowDefinitionError while preserving ValueError compatibility and existing carrier/assignment guards. Include stable reason_code, workflow_id, exact step_id, field location, offending reference and actionable correction. Add focused valid-control/one-mutation assertions for malformed loop bodies, unsupported route labels and unknown input templates, plus inventory JSON diagnostic projection. Reopen or record required T002/T006 validation ownership through the existing task-analysis and eligibility path before their effects.",
      "id": "F023-CONVERGE-DIAGNOSTIC-CONTEXT",
      "observed_deficiency": "Malformed do-while body (line 517), invalid switch transition_labels (line 481), and unknown template input (line 343) raise plain ValueError without a diagnostic. Each independently accepted valid control was mutated at one field. The observed messages omit workflow ID and exact field location; the template message also omits consumer ID. The inventory --json handler only projects errors carrying a diagnostic, so these paths bypass the promised portable diagnostic projection. Rejection itself remains effective.",
      "reproductions": [
        {
          "case_id": "malformed-loop-body",
          "diagnostic": null,
          "error_type": "ValueError",
          "message": "do-while steps must be a nonempty list: reviewed-loop",
          "mutation_field": "steps",
          "result": "rejected",
          "valid_control": "accepted"
        },
        {
          "case_id": "unsupported-route-label",
          "diagnostic": null,
          "error_type": "ValueError",
          "message": "transition labels must name existing branches with nonempty text: reviewed-route",
          "mutation_field": "transition_labels",
          "result": "rejected",
          "valid_control": "accepted"
        },
        {
          "case_id": "unknown-template-input",
          "diagnostic": null,
          "error_type": "ValueError",
          "message": "unsupported template input: absent",
          "mutation_field": "prompt",
          "result": "rejected",
          "valid_control": "accepted"
        }
      ],
      "severity": "medium",
      "task_id": "T005",
      "violated_requirement": "FR-002; contracts/validation-boundaries.md requires structural/template failures to identify workflow, exact consuming/switch step, field/reference and correction. T005 owns shared definition/graph/template validation; T002/T006 own focused assertions and projection."
    }
  ],
